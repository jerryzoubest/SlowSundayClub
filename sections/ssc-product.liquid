{% assign current_variant = product.selected_or_first_available_variant %}

<section class="ssc-product">
  <nav class="ssc-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span>/</span>
    <a href="{{ routes.all_products_collection_url }}">Shop</a>
    <span>/</span>
    <span>{{ product.title }}</span>
  </nav>

  <div class="ssc-product__grid">
    <div class="ssc-product__media">
      {% if product.featured_media %}
        <div class="ssc-product__image">
          {{ product.featured_media | image_url: width: 1100 | image_tag: loading: 'eager', widths: '520, 760, 1100', alt: product.title }}
        </div>
      {% else %}
        <div class="ssc-placeholder ssc-placeholder--product"></div>
      {% endif %}

      {% if product.media.size > 1 %}
        <div class="ssc-thumbs" aria-label="Product images">
          {% for media in product.media limit: 4 %}
            <button type="button"
              data-ssc-thumb="{{ media | image_url: width: 1100 }}"
              data-ssc-alt="{{ media.alt | default: product.title | escape }}"
              {% if forloop.first %}class="is-active"{% endif %}>
              {{ media | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 140, 180', alt: media.alt | default: product.title }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="ssc-product__info">
      <h1>{{ product.title }}</h1>
      <p class="ssc-price">{{ current_variant.price | money }}</p>
      <p class="ssc-stock {% if current_variant.available %}ssc-stock--ok{% endif %}">
        {% if current_variant.available %}In stock{% else %}Sold out{% endif %}
      </p>

      {% if product.description != blank %}
        <div class="ssc-product__description">
          {{ product.description | strip_html | truncatewords: 34 }}
        </div>
      {% endif %}

      {% form 'product', product, class: 'ssc-product-form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <fieldset class="ssc-option">
              <legend>{{ option.name }}</legend>
              <div class="ssc-option__values">
                {% for value in option.values %}
                  {% assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 %}
                  <label for="{{ input_id }}" class="{% if option.name == 'Color' or option.name == 'Colour' %}ssc-swatch{% endif %}">
                    <input
                      id="{{ input_id }}"
                      type="radio"
                      name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}
                    >
                    <span {% if option.name == 'Color' or option.name == 'Colour' %}style="--swatch: {{ value | handle | replace: '-', '' }}"{% endif %}>
                      {{ value }}
                    </span>
                  </label>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        {% endunless %}

        <label class="ssc-quantity">
          <span>Quantity</span>
          <span class="ssc-stepper">
            <button type="button" data-ssc-minus aria-label="Decrease quantity">&minus;</button>
            <input type="number" name="quantity" value="1" min="1">
            <button type="button" data-ssc-plus aria-label="Increase quantity">+</button>
          </span>
        </label>

        <button class="ssc-button ssc-button--dark" type="submit" {% unless current_variant.available %}disabled{% endunless %}>
          {% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}
        </button>

        {{ form | payment_button }}
      {% endform %}

      <div class="ssc-trust-row" aria-label="Shopping guarantees">
        <span>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7z"/>
            <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
          Free shipping Rp 500k+
        </span>
        <span>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"/>
            <path d="M3.51 15a9 9 0 1 0 .49-3.89"/>
          </svg>
          30-day Returns
        </span>
        <span>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Secure Checkout
        </span>
      </div>

      <button class="ssc-wishlist" type="button">&#9825; Save to Wishlist</button>

      <div class="ssc-accordions">
        <details>
          <summary>Product Details</summary>
          <div>{{ product.description }}</div>
        </details>
        <details>
          <summary>Material &amp; Care</summary>
          <div>{{ section.settings.material_care }}</div>
        </details>
        <details>
          <summary>Shipping &amp; Returns</summary>
          <div>{{ section.settings.shipping_returns }}</div>
        </details>
      </div>

      <script type="application/json" data-ssc-variants>
        {{ product.variants | json }}
      </script>
    </div>
  </div>
</section>

<div class="ssc-sticky-atc" aria-hidden="true">
  <div class="ssc-sticky-atc__info">
    <span class="ssc-sticky-atc__title">{{ product.title }}</span>
    <span class="ssc-sticky-atc__price">{{ current_variant.price | money }}</span>
  </div>
  <button class="ssc-button ssc-button--dark" type="button" {% unless current_variant.available %}disabled{% endunless %}>
    {% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}
  </button>
</div>

{% schema %}
{
  "name": "SSC Product",
  "settings": [
    {
      "type": "richtext",
      "id": "material_care",
      "label": "Material and care",
      "default": "<p>Wash cold, air dry, and store away from direct sun.</p>"
    },
    {
      "type": "richtext",
      "id": "shipping_returns",
      "label": "Shipping and returns",
      "default": "<p>Free shipping on orders over Rp 500.000. Easy 30-day returns.</p>"
    }
  ]
}
{% endschema %}
