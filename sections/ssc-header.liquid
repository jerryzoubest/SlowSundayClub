{% assign header_menu = section.settings.menu %}

<header class="ssc-header">
  <nav class="ssc-header__nav" aria-label="Primary navigation">
    {% if header_menu != blank and header_menu.links.size > 0 %}
      {% for link in header_menu.links limit: 4 %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    {% else %}
      <a href="/collections/all">Shop</a>
      <a href="/pages/about">About</a>
      <a href="/pages/lookbook">Lookbook</a>
      <a href="/blogs/journal">Journal</a>
    {% endif %}
  </nav>

  <a class="ssc-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
    {% if section.settings.logo != blank %}
      {{ section.settings.logo | image_url: width: 320 | image_tag: loading: 'eager', widths: '160, 240, 320', alt: shop.name }}
    {% else %}
      {{ section.settings.logo_text | default: shop.name | escape }}
    {% endif %}
  </a>

  <div class="ssc-header__actions">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <button type="submit" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 5 5"></path></svg>
      </button>
    </form>
    <a href="{{ routes.account_url }}" aria-label="Account">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 22c1.6-4.1 4.2-6 8-6s6.4 1.9 8 6"></path></svg>
    </a>
    <a class="ssc-cart-link ssc-cart-drawer-toggle" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8h14l-2 10H8L6 3H3"></path><circle cx="9" cy="21" r="1"></circle><circle cx="18" cy="21" r="1"></circle></svg>
      <span class="ssc-cart-count" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>
</header>

<div class="ssc-drawer-overlay" aria-hidden="true"></div>

<aside class="ssc-cart-drawer" role="dialog" aria-label="Shopping cart" aria-modal="true">
  <div class="ssc-cart-drawer__header">
    <h2>Your Bag</h2>
    <button class="ssc-cart-drawer__close" aria-label="Close cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="ssc-shipping-bar">
    <p class="ssc-shipping-bar__msg">Add more for free shipping</p>
    <div class="ssc-shipping-bar__track">
      <div class="ssc-shipping-bar__fill" style="width: 0%"></div>
    </div>
  </div>

  <div class="ssc-cart-drawer__items">
    <div class="ssc-cart-drawer__empty">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <p>Your bag is empty.</p>
      <a href="/collections/all">Browse collection &rarr;</a>
    </div>
  </div>

  <div class="ssc-cart-drawer__footer">
    <div class="ssc-drawer-subtotal">
      <span>Subtotal</span>
      <strong data-drawer-subtotal>&mdash;</strong>
    </div>
    <p class="ssc-drawer-footer__note">Taxes &amp; shipping calculated at checkout.</p>
    <a class="ssc-button ssc-button--dark" href="{{ routes.checkout_url }}">Checkout Securely</a>
    <button type="button" class="ssc-cart-drawer__close ssc-drawer-footer__continue">
      Continue Shopping
    </button>
  </div>
</aside>

{% schema %}
{
  "name": "SSC Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Slow Sunday Club"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
