{% assign featured_collection = section.settings.collection | default: collections.all %}

<section class="ssc-hero">
  <div class="ssc-hero__copy">
    <p class="ssc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p>{{ section.settings.text | escape }}</p>
    {% if section.settings.button_label != blank %}
      <a class="ssc-button ssc-button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>
  <div class="ssc-hero__media">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', alt: section.settings.heading }}
    {% elsif featured_collection.products.first.featured_image %}
      {{ featured_collection.products.first.featured_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', alt: featured_collection.products.first.title }}
    {% else %}
      <div class="ssc-placeholder ssc-placeholder--hero"></div>
    {% endif %}
  </div>
</section>

<section class="ssc-section">
  <div class="ssc-section__heading">
    <h2>{{ section.settings.category_heading | default: 'Shop By Category' | escape }}</h2>
  </div>
  <div class="ssc-essential-grid">
    {% for product in featured_collection.products limit: 3 %}
      <a class="ssc-essential-card" href="{{ product.url }}">
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '320, 480, 720', alt: product.title }}
        {% else %}
          <div class="ssc-placeholder"></div>
        {% endif %}
        <h3>{{ product.title }}</h3>
        <p>{{ product.type | default: 'Slow Sunday essential' }}</p>
        <span>Shop Now</span>
      </a>
    {% else %}
      {% assign fallback_titles = 'Yoga Socks,Water Bottles,Yoga Bags' | split: ',' %}
      {% assign fallback_subs = 'Comfort &amp; Grip,Hydrate in Style,Carry Your Flow' | split: ',' %}
      {% for title in fallback_titles %}
        <article class="ssc-essential-card">
          <div class="ssc-placeholder"></div>
          <h3>{{ title }}</h3>
          <p>{{ fallback_subs[forloop.index0] }}</p>
          <span>Shop Now</span>
        </article>
      {% endfor %}
    {% endfor %}
  </div>
</section>

<section class="ssc-feature">
  <div class="ssc-feature__copy">
    <h2>{{ section.settings.feature_heading | escape }}</h2>
    <p>{{ section.settings.feature_text | escape }}</p>
    <a class="ssc-button ssc-button--light" href="{{ section.settings.feature_link | default: '/pages/about' }}">
      {{ section.settings.feature_button | default: 'Learn More' | escape }}
    </a>
  </div>
  <div class="ssc-feature__media">
    {% if section.settings.feature_image != blank %}
      {{ section.settings.feature_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', alt: section.settings.feature_heading }}
    {% elsif featured_collection.products[1].featured_image %}
      {{ featured_collection.products[1].featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', alt: featured_collection.products[1].title }}
    {% else %}
      <div class="ssc-placeholder ssc-placeholder--wide"></div>
    {% endif %}
  </div>
</section>

<section class="ssc-values" aria-label="Why shop with us">
  <article>
    <span aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 21c5-2 8-6 8-12V4l-8 2-8-2v5c0 6 3 10 8 12Z"></path><path d="M12 8v8"></path></svg>
    </span>
    <h2>Sustainable</h2>
    <p>Eco-friendly materials</p>
  </article>
  <article>
    <span aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 3c2 3 2 5 0 8-2-3-2-5 0-8Z"></path><path d="M4 13c3-1 5 0 8 3-3 1-5 0-8-3Z"></path><path d="M20 13c-3-1-5 0-8 3 3 1 5 0 8-3Z"></path></svg>
    </span>
    <h2>Mindful Design</h2>
    <p>Made for your flow</p>
  </article>
  <article>
    <span aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 5 3.5 7.5 8 9 4.5-1.5 8-4 8-9V6l-8-3Z"></path><path d="m9 12 2 2 4-4"></path></svg>
    </span>
    <h2>Quality First</h2>
    <p>Durable &amp; long-lasting</p>
  </article>
  <article>
    <span aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10Z"></path></svg>
    </span>
    <h2>Support Wellness</h2>
    <p>For every step of your journey</p>
  </article>
</section>

<section class="ssc-section">
  <div class="ssc-section__heading">
    <h2>Journal &amp; Inspiration</h2>
  </div>
  <div class="ssc-journal-grid">
    {% assign journal = section.settings.blog %}
    {% for article in journal.articles limit: 4 %}
      <a class="ssc-journal-card" href="{{ article.url }}">
        {% if article.image %}
          {{ article.image | image_url: width: 520 | image_tag: loading: 'lazy', widths: '260, 390, 520', alt: article.title }}
        {% else %}
          <div class="ssc-placeholder"></div>
        {% endif %}
        <h3>{{ article.title }}</h3>
        <span>Read More</span>
      </a>
    {% else %}
      {% assign fallback_articles = "Morning Routine for More Energy,Why Hydration Matters,What's in My Yoga Bag,5 Gentle Stretches for Rest Days" | split: ',' %}
      {% for title in fallback_articles %}
        <article class="ssc-journal-card">
          <div class="ssc-placeholder"></div>
          <h3>{{ title }}</h3>
          <span>Read More</span>
        </article>
      {% endfor %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "SSC Home",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Journal blog"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Move. Breathe. Connect."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mindful Essentials for Your Flow"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Thoughtful pieces for your practice, your routine, your calm."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "category_heading",
      "label": "Category section heading",
      "default": "Shop By Category"
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Feature image"
    },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "Feature heading",
      "default": "Designed for Movement & Mindfulness"
    },
    {
      "type": "textarea",
      "id": "feature_text",
      "label": "Feature text",
      "default": "Thoughtful essentials that support your practice, on and off the mat."
    },
    {
      "type": "text",
      "id": "feature_button",
      "label": "Feature button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "feature_link",
      "label": "Feature button link"
    }
  ]
}
{% endschema %}
