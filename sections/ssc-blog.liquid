<section class="ssc-page">
  <header class="ssc-page-hero">
    <p class="ssc-eyebrow">Journal</p>
    <h1>{{ blog.title }}</h1>
  </header>

  {% paginate blog.articles by 12 %}
    <div class="ssc-journal-grid">
      {% for article in blog.articles %}
        <a class="ssc-journal-card" href="{{ article.url }}">
          {% if article.image %}
            {{ article.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '320, 480, 720', alt: article.title }}
          {% else %}
            <div class="ssc-placeholder"></div>
          {% endif %}
          <h3>{{ article.title }}</h3>
          <span>Read More</span>
        </a>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      <nav class="ssc-pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "SSC Blog"
}
{% endschema %}
